# auto、napcat 或 snowluma。auto 会通过 get_version_info 自动识别。
QQPET_RUNTIME=snowluma
QQPET_BOT_UIN=750528872

# NapCat 或 SnowLuma 为当前 QQ 配置的 OneBot HTTP 服务
QQPET_ONEBOT_URL=http://127.0.0.1:3002

# OneBot HTTP 配置了 access token 时填写；未配置则留空
QQPET_ONEBOT_TOKEN=

# QQ 宠物独立 Web UI，默认只允许本机访问
QQPET_WEB_HOST=127.0.0.1
QQPET_WEB_PORT=8091

# Miku 使用独立数据目录，避免和 Nico 同时运行时互相覆盖。
QQPET_DATA_DIR=data
