# Ignore files generated by Claude
.claude

# Node / pnpm / monorepo
node_modules/
**/node_modules/
dist/
**/dist/
.vscode/
.idea/

/config/
/data/
# per-package runtime data dirs (e.g. packages/core/data/<uin>/*.db written by
# IdentityService during tests) — not just the root /data/
**/data/
logs/

# Local reverse-engineering scratch files belong under Plugin/Miku, not at the
# repository root. Keep accidental root copies out of commits.
/config.env
/deobfuscated.js
/index.obfuscated.mjs
/index.readable-pre-local-renames.mjs
/rename-locals.mjs
/rename-top-level.mjs

# macOS metadata
.DS_Store

# test coverage output
coverage/
